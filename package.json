{
	"name": "property-pulse",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"admin",
		"web",
		"api"
	],
	"scripts": {
		"start": "concurrently \"npm run start:api\" \"npm run start:web\" \"npm run start:admin\"",
		"start:api": "npm start --workspace=api",
		"start:web": "npm start --workspace=web",
		"start:admin": "npm start --workspace=admin",
		"dev": "concurrently \"nodemon --workspace=api\" \"npm run dev:web\" \"npm run dev:admin\"",
		"dev:api": "nodemon --workspace=api",
		"dev:web": "npm start --workspace=web",
		"dev:admin": "npm start --workspace=admin",
		"build": "npm run build --workspaces",
		"build:api": "npm run build --workspace=api",
		"build:web": "npm run build --workspace=web",
		"build:admin": "npm run build --workspace=admin",
		"install:all": "npm install && npm install --workspaces",
		"clean": "rm -rf node_modules && rm -rf */node_modules",
		"reset": "npm run clean && npm run install:all"
	},
	"devDependencies": {
		"concurrently": "^8.2.2"
	}
}
